{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",                  // التحديث الصح لـ TS 6
    "moduleResolution": "NodeNext",          // التحديث الصح لـ TS 6
    "lib": ["ES2022"],
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "paths": {
      "@common/*": ["./src/common/*"],
      "@config/*": ["./src/config/*"],
      "@modules/*": ["./src/modules/*"],
      "@infrastructure/*": ["./src/infrastructure/*"]
    },
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "tsconfig.json"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts"]
}